# Copy this file to .env in the project root. Never commit .env.
# QQ mailbox -> Settings -> Account / Account security -> POP3/IMAP/SMTP
# Enable SMTP and generate an authorization code (NOT your QQ login password).
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-qq-number@qq.com
SMTP_PASS=replace-with-qq-smtp-authorization-code
# Generate a private random value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RESET_CODE_SECRET=replace-with-your-own-random-secret-at-least-32-characters

# Restore your existing private JWT secret locally; never publish it.
JWT_SECRET=REPLACE_WITH_YOUR_EXISTING_PRIVATE_JWT_SECRET

# ---------------------------------------------------------------------------
# AI assistant for the chat app (chat-server reads these from this .env file).
# Works with any OpenAI-compatible /chat/completions endpoint.
# Default (free): Zhipu GLM — register at https://open.bigmodel.cn and create
# an API key; the glm-4-flash model is free to call.
# Leave AI_API_KEY empty to disable the AI feature (the app shows a notice).
AI_API_KEY=replace-with-your-ai-api-key-or-leave-empty
AI_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4-flash
